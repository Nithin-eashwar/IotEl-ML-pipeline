# Azure IoT Hub credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

IOT_HUB_HOSTNAME=motor-predictor-hub.azure-devices.net
IOT_HUB_DEVICE_ID=stepper-motor-1-tvl5ry
IOT_HUB_SHARED_ACCESS_KEY=your-shared-access-key-here

# Serial port for the ESP32 (Windows: COM5, Linux/Mac: /dev/ttyUSB0)
# Run: python -m serial.tools.list_ports  to find yours.
COM_PORT=COM5
